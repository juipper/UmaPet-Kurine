{
  "name": "umapet",
  "productName": "赛马娘桌宠",
  "version": "2.3.2",
  "description": "赛马娘桌宠 · 正面本体贴图版 · 形象已清理（Electron + three.js）",
  "main": "src/main/main.js",
  "author": "juipper",
  "license": "MIT",
  "scripts": {
    "build:renderer": "esbuild src/renderer/js/app.js --bundle --format=iife --outfile=src/renderer/bundle.js --log-level=warning",
    "start": "electron .",
    "dev": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win portable",
    "pack:dir": "npm run build:renderer && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  },
  "build": {
    "appId": "com.juipper.umapet",
    "productName": "赛马娘桌宠",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/sprites/deg_000.png",
      "assets/sprites/blink/deg_000_eye.png",
      "package.json",
      "!electron_runtime/**",
      "!release/**",
      "!tools/**",
      "!legacy/**",
      "!*.log"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "UmaPet-Portable-${version}.exe"
    },
    "electronDist": "electron_runtime"
  }
}